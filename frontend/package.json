    "lint:setup": "npm ci --prefix tools/lint",
    "format:check": "tools/lint/node_modules/.bin/prettier --config tools/lint/prettierrc.json --check tools/lint/eslint.config.js tools/lint/prettierrc.json",
    "format": "tools/lint/node_modules/.bin/prettier --config tools/lint/prettierrc.json --write"
  },
