# mock (default): the zustand demo data, no backend needed. live: talk to the Laravel API.
VITE_API_MODE=mock

# Leave empty for same-origin (Vite proxy in dev, nginx in production). Cookies need same-origin.
VITE_API_BASE_URL=

# Dev only: where the Vite proxy sends /api and /sanctum.
VITE_PROXY_TARGET=http://localhost:8000
